{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "AxisUtah.Api": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "DefaultConnection"
  },
  "MlsApi": {
    "BaseUrl": "https://example.com/reso/odata/",
    "BearerToken": "your-api-key-here"
  },
  "MlsSync": {
    "RunInBackground": true,
    "IntervalMinutes": 30,
    "InitialLookbackHours": 24
  },
  "SyncAutomation": {
    "ApiKey": "replace-with-a-long-random-sync-key"
  },
  "Jwt": {
    "Key": "JwtSettings:Key",
    "Issuer": "AxisUtah.API",
    "Audience": "AxisUtah.Client",
    "ExpiryMinutes": 60
  }
}